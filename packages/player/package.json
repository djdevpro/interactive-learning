{
  "name": "@interactive-learning/player",
  "version": "0.1.0",
  "description": "One interactive guide player for HTML, Vanilla JavaScript, React and Svelte.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djdevpro/interactive-learning.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/djdevpro/interactive-learning#readme",
  "bugs": "https://github.com/djdevpro/interactive-learning/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "scripts": {
    "build": "vite build && svelte-package -i svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "typecheck": "vue-tsc --noEmit && svelte-check --tsconfig tsconfig.svelte.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@interactive-learning/protocol": "workspace:*",
    "@microsoft/api-extractor": "7.59.4",
    "@sveltejs/package": "3.0.1",
    "@types/react": "19.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "react": "19.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
