{
  "name": "@interactive-learning/player",
  "version": "0.2.0",
  "description": "Interactive guide player as a standard Web Component built with Lit, usable from HTML or any framework.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djdevpro/interactive-learning.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/djdevpro/interactive-learning#readme",
  "bugs": "https://github.com/djdevpro/interactive-learning/issues",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "dist/custom-elements.json",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4316 --strictPort",
    "build": "vite build && cem analyze --litelement --globs src/InteractiveLearningElement.ts --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@interactive-learning/protocol": "workspace:*",
    "@microsoft/api-extractor": "7.59.4",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
