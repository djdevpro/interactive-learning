{
  "name": "@interactive-learning/vue",
  "version": "0.1.0",
  "description": "Lecteur Vue de guides interactifs portables, avec captures, pointeur et annotations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djdevpro/interactive-learning.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/djdevpro/interactive-learning/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/djdevpro/interactive-learning/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
