    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@interactive-learning/protocol": "workspace:*",
    "@microsoft/api-extractor": "7.59.4",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "unplugin-dts": "1.1.2",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "publishConfig": {
    "access": "public"
  }
