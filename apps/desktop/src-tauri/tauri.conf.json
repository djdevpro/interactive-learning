{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interactive Learning Studio",
  "version": "0.2.0",
  "identifier": "dev.interactive-learning.studio",
  "build": {
    "beforeDevCommand": "pnpm ui:dev",
    "devUrl": "http://127.0.0.1:4340",
    "beforeBuildCommand": "pnpm ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
